{
	# Real client IP: Cloudflare sends it in CF-Connecting-IP. Trust that header only from Cloudflare's ranges
	# (https://www.cloudflare.com/ips/ — re-check occasionally).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.carsua.app {
	tls /certs/origin.pem /certs/origin.key {
		# Authenticated Origin Pulls (docs/origin-hardening-plan.md H2): Cloudflare presents our per-zone client cert on the origin leg.
		# Enforced: a direct hit without Cloudflare's client cert fails the TLS handshake. Escape hatch: Zone-level AOP toggle off + mode verify_if_given, deploy.
		client_auth {
			mode require_and_verify
			trust_pool file /certs/cf-aop.pem
		}
	}
	redir https://carsua.app{uri} permanent
}

carsua.app {
	tls /certs/origin.pem /certs/origin.key {
		# Authenticated Origin Pulls (docs/origin-hardening-plan.md H2): Cloudflare presents our per-zone client cert on the origin leg.
		# Enforced: a direct hit without Cloudflare's client cert fails the TLS handshake. Escape hatch: Zone-level AOP toggle off + mode verify_if_given, deploy.
		client_auth {
			mode require_and_verify
			trust_pool file /certs/cf-aop.pem
		}
	}
	# Stock Caddy has no Brotli encoder. Cloudflare passes an already-compressed origin response through unchanged (verified
	# 2026-10-28: browsers got gzip), but compresses an uncompressed one itself - to Brotli when the browser accepts it.
	# So requests that came through Cloudflare are sent plain; only direct hits (no CF-Connecting-IP) are compressed here.
	@direct not header Cf-Connecting-Ip *
	encode @direct zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
		# allow-popups, never same-origin: the Google / Telegram sign-in popups must keep window.opener (PLAN.md Helmet review).
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Origin-Agent-Cluster "?1"
		X-Permitted-Cross-Domain-Policies "none"
	}

	# CSP directives, one per row (a Caddyfile string cannot span lines); the headers below join them with "; ".
	# upgrade-insecure-requests is not here on purpose: browsers ignore it in Report-Only and log a console error per frame. Add it when the header is renamed to Content-Security-Policy.
	vars {
		csp_site_default_src "default-src 'self'"
		csp_site_base_uri "base-uri 'self'"
		csp_site_object_src "object-src 'none'"
		csp_site_script_src_attr "script-src-attr 'none'"
		csp_site_frame_ancestors "frame-ancestors 'self'"
		csp_site_form_action "form-action 'self'"
		csp_site_img_src "img-src 'self' data: blob: https:"
		csp_site_media_src "media-src 'self' https:"
		csp_site_font_src "font-src 'self' data:"
		csp_site_style_src "style-src 'self' 'unsafe-inline' https://accounts.google.com"
		csp_site_script_src "script-src 'self' 'wasm-unsafe-eval' 'report-sample' https://static.cloudflareinsights.com https://accounts.google.com https://telegram.org https://challenges.cloudflare.com https://eu-assets.i.posthog.com https://us-assets.i.posthog.com https://*.disqus.com https://*.disquscdn.com"
		csp_site_connect_src "connect-src 'self' https://huggingface.co https://*.hf.co https://eu.i.posthog.com https://eu-assets.i.posthog.com https://us.i.posthog.com https://us-assets.i.posthog.com https://*.sentry.io https://accounts.google.com https://api.bsky.app https://api.stackexchange.com https://lemmy.world https://*.wikimedia.org https://*.disqus.com"
		csp_site_frame_src "frame-src 'self' https://accounts.google.com https://oauth.telegram.org https://challenges.cloudflare.com https://www.youtube-nocookie.com https://www.youtube.com https://sketchfab.com https://carshow360.net https://stock.winner.ua https://maps.google.com https://www.google.com https://phoboslab.org https://disqus.com"
		csp_site_report_uri "report-uri /api/csp-report"
		csp_frame_default_src "default-src 'none'"
		csp_frame_base_uri "base-uri 'none'"
		csp_frame_frame_ancestors "frame-ancestors 'self'"
		csp_frame_script_src "script-src 'self' 'unsafe-eval' 'report-sample' https://telegram.org https://static.cloudflareinsights.com"
		csp_frame_frame_src "frame-src https://oauth.telegram.org"
		csp_frame_connect_src "connect-src 'self' https://oauth.telegram.org"
		csp_frame_img_src "img-src https:"
		csp_frame_style_src "style-src 'self' 'unsafe-inline'"
		csp_frame_report_uri "report-uri /api/csp-report"
	}

	# CSP: Report-Only first; enforce after a week of clean browser consoles (docs/security-checklist.md finding 2).
	# /telegram-frame.html is excluded here and has its own policy below, so the two are independent: flipping the site-wide
	# header to Content-Security-Policy no longer touches the Telegram page (and vice versa).
	@notTelegramFrame not path /telegram-frame.html
	header @notTelegramFrame {
		Content-Security-Policy-Report-Only "{vars.csp_site_default_src}; {vars.csp_site_base_uri}; {vars.csp_site_object_src}; {vars.csp_site_script_src_attr}; {vars.csp_site_frame_ancestors}; {vars.csp_site_form_action}; {vars.csp_site_img_src}; {vars.csp_site_media_src}; {vars.csp_site_font_src}; {vars.csp_site_style_src}; {vars.csp_site_script_src}; {vars.csp_site_connect_src}; {vars.csp_site_frame_src}; {vars.csp_site_report_uri}"
	}

	# Telegram login widget host (apps/web/public/telegram-frame.html): telegram-widget.js eval()s its data-onauth attribute,
	# so this one same-origin page gets 'unsafe-eval'; the app itself never does. Own policy, enforce it whenever ready.
	header /telegram-frame.html {
		Content-Security-Policy-Report-Only "{vars.csp_frame_default_src}; {vars.csp_frame_base_uri}; {vars.csp_frame_frame_ancestors}; {vars.csp_frame_script_src}; {vars.csp_frame_frame_src}; {vars.csp_frame_connect_src}; {vars.csp_frame_img_src}; {vars.csp_frame_style_src}; {vars.csp_frame_report_uri}"
	}

	# Planned maintenance: `touch /opt/carsua/compose/flags/MAINTENANCE`. /healthz stays reachable for the deploy script.
	@maint {
		file {
			root /
			try_files /flags/MAINTENANCE
		}
		not path /healthz
	}
	handle @maint {
		error 503
	}

	handle {
		reverse_proxy api-blue:3000 api-green:3000 {
			lb_policy first
			lb_try_duration 15s
			lb_try_interval 250ms
			health_uri /healthz
			health_interval 2s
			health_timeout 2s
			# Cloudflare appends to XFF and the client can pre-set it; only the verified IP goes upstream.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# API unreachable (deploy gap, crash, maintenance flag): pages get a self-refreshing notice, /api gets JSON
	# that the web app turns into a "server is updating" banner.
	handle_errors 502 503 504 {
		header Retry-After 30
		header Cache-Control "no-store"
		@api path /api/* /healthz
		handle @api {
			header Content-Type application/json
			respond `{"status":"maintenance","retryAfter":30}` 503
		}
		handle {
			rewrite * /maintenance.html
			file_server {
				root /srv
				status 503
			}
		}
	}
}
