{
  "name": "carplates-v2",
  "version": "0.1.0",
  "description": "Ukrainian car plate + VIN lookup — monorepo (web + api + shared + scripts)",
  "private": true,
  "license": "MIT",
  "author": "Ruslan Korkin <rukrak86@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @carplates/shared --filter @carplates/db build && pnpm --filter @carplates/api --filter @carplates/web build",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "lint:types": "eslint . --config eslint.config.types.mjs --cache --cache-location node_modules/.cache/eslint-types/",
    "type-check": "pnpm -r type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:reset": "docker compose -f infra/docker-compose.yml down -v && docker compose -f infra/docker-compose.yml up -d",
    "db:migrate": "pnpm --filter @carplates/db db:migrate",
    "db:generate": "pnpm --filter @carplates/db db:generate",
    "db:studio": "pnpm --filter @carplates/db db:studio",
    "db:seed": "pnpm --filter @carplates/scripts seed",
    "db:refresh-stats": "pnpm --filter @carplates/scripts refresh-stats",
    "alpr:build": "docker compose -f infra/docker-compose.alpr.yml build",
    "alpr:up": "docker compose -f infra/docker-compose.alpr.yml up -d",
    "alpr:down": "docker compose -f infra/docker-compose.alpr.yml down",
    "ingest": "pnpm --filter @carplates/scripts ingest",
    "ingest:full": "pnpm --filter @carplates/scripts ingest:full",
    "ingest:all": "pnpm db:migrate && concurrently -n full,ratings \"pnpm ingest:full\" \"pnpm ingest:ratings:csv\" && pnpm db:refresh-fuel-stats && pnpm db:refresh-safety-stats",
    "ingest:ratings:csv": "pnpm db:migrate && concurrently -n euroncap,jncap,cncap,kncap,iihs,fuel,infocar,videos,edrive,sketchfab,carshow360,topgear \"pnpm ingest:euroncap:csv\" \"pnpm ingest:jncap:csv\" \"pnpm ingest:cncap:csv\" \"pnpm ingest:kncap:csv\" \"pnpm ingest:iihs:csv\" \"pnpm ingest:fuel:csv\" \"pnpm ingest:infocar:csv\" \"pnpm ingest:infocar:videos:csv\" \"pnpm ingest:edrive:csv\" \"pnpm ingest:sketchfab:csv\" \"pnpm ingest:carshow360:csv\" \"pnpm ingest:topgear:csv\"",
    "ingest:euroncap": "pnpm --filter @carplates/scripts ingest:euroncap",
    "ingest:euroncap:csv": "pnpm --filter @carplates/scripts ingest:euroncap:csv",
    "export:euroncap:csv": "pnpm --filter @carplates/scripts export:euroncap:csv",
    "ingest:jncap": "pnpm --filter @carplates/scripts ingest:jncap",
    "ingest:jncap:csv": "pnpm --filter @carplates/scripts ingest:jncap:csv",
    "export:jncap:csv": "pnpm --filter @carplates/scripts export:jncap:csv",
    "ingest:cncap": "pnpm --filter @carplates/scripts ingest:cncap",
    "ingest:cncap:csv": "pnpm --filter @carplates/scripts ingest:cncap:csv",
    "export:cncap:csv": "pnpm --filter @carplates/scripts export:cncap:csv",
    "ingest:kncap": "pnpm --filter @carplates/scripts ingest:kncap",
    "ingest:kncap:csv": "pnpm --filter @carplates/scripts ingest:kncap:csv",
    "export:kncap:csv": "pnpm --filter @carplates/scripts export:kncap:csv",
    "ingest:iihs": "pnpm --filter @carplates/scripts ingest:iihs",
    "ingest:iihs:csv": "pnpm --filter @carplates/scripts ingest:iihs:csv",
    "export:iihs:csv": "pnpm --filter @carplates/scripts export:iihs:csv",
    "ingest:infocar": "pnpm --filter @carplates/scripts ingest:infocar",
    "ingest:infocar:csv": "pnpm --filter @carplates/scripts ingest:infocar:csv",
    "export:infocar:csv": "pnpm --filter @carplates/scripts export:infocar:csv",
    "ingest:edrive": "pnpm --filter @carplates/scripts ingest:edrive",
    "ingest:edrive:csv": "pnpm --filter @carplates/scripts ingest:edrive:csv",
    "export:edrive:csv": "pnpm --filter @carplates/scripts export:edrive:csv",
    "ingest:topgear": "pnpm --filter @carplates/scripts ingest:topgear",
    "ingest:topgear:csv": "pnpm --filter @carplates/scripts ingest:topgear:csv",
    "export:topgear:csv": "pnpm --filter @carplates/scripts export:topgear:csv",
    "ingest:infocar:videos": "pnpm --filter @carplates/scripts ingest:infocar:videos",
    "ingest:infocar:videos:csv": "pnpm --filter @carplates/scripts ingest:infocar:videos:csv",
    "export:infocar:videos:csv": "pnpm --filter @carplates/scripts export:infocar:videos:csv",
    "ingest:sketchfab": "pnpm --filter @carplates/scripts ingest:sketchfab",
    "ingest:sketchfab:csv": "pnpm --filter @carplates/scripts ingest:sketchfab:csv",
    "export:sketchfab:csv": "pnpm --filter @carplates/scripts export:sketchfab:csv",
    "ingest:carshow360": "pnpm --filter @carplates/scripts ingest:carshow360",
    "ingest:carshow360:csv": "pnpm --filter @carplates/scripts ingest:carshow360:csv",
    "export:carshow360:csv": "pnpm --filter @carplates/scripts export:carshow360:csv",
    "ingest:fuel": "pnpm --filter @carplates/scripts ingest:fuel",
    "ingest:fuel:csv": "pnpm --filter @carplates/scripts ingest:fuel:csv",
    "export:fuel:csv": "pnpm --filter @carplates/scripts export:fuel:csv",
    "db:refresh-fuel-stats": "pnpm --filter @carplates/scripts refresh-fuel-stats",
    "db:refresh-safety-stats": "pnpm --filter @carplates/scripts refresh-safety-stats"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
