{
  "name": "carplates-v2",
  "version": "0.1.0",
  "description": "Ukrainian car plate + VIN lookup — monorepo (web + api + shared + scripts)",
  "private": true,
  "license": "MIT",
  "author": "Ruslan Korkin <rukrak86@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @carplates/shared --filter @carplates/db build && pnpm --filter @carplates/api --filter @carplates/web build",
    "tunnel": "pnpm --filter @carplates/scripts tunnel",
    "preview:prod": "pnpm build && pnpm --filter @carplates/api preview",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "lint:types": "eslint . --config eslint.config.types.mjs --cache --cache-location node_modules/.cache/eslint-types/",
    "type-check": "pnpm -r type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:reset": "docker compose -f infra/docker-compose.yml down -v && docker compose -f infra/docker-compose.yml up -d",
    "db:migrate": "pnpm --filter @carplates/db db:migrate",
    "db:generate": "pnpm --filter @carplates/db db:generate",
    "db:studio": "pnpm --filter @carplates/db db:studio",
    "db:seed": "pnpm --filter @carplates/scripts seed",
    "db:refresh-stats": "pnpm --filter @carplates/scripts refresh-stats",
    "alpr:build": "docker compose -f infra/docker-compose.alpr.yml build",
    "alpr:up": "docker compose -f infra/docker-compose.alpr.yml up -d",
    "alpr:down": "docker compose -f infra/docker-compose.alpr.yml down",
    "ingest": "pnpm --filter @carplates/scripts ingest",
    "ingest:full": "pnpm --filter @carplates/scripts ingest:full",
    "ingest:all": "pnpm db:migrate && concurrently -n full,ratings \"pnpm ingest:full -- --skip-derived\" \"pnpm ingest:ratings:csv\" && pnpm db:refresh-derived",
    "ingest:ratings:csv": "pnpm db:migrate && concurrently -n euroncap,jncap,cncap,kncap,iihs,fuel,infocar,videos,hondavid,edrive,sketchfab,carshow360,topgear,press,wikiimg,vehiclesdb,rdw,openev,mot,carecalls,generations,wikispecs,news,social,winner360 \"pnpm ingest:euroncap:csv\" \"pnpm ingest:jncap:csv\" \"pnpm ingest:cncap:csv\" \"pnpm ingest:kncap:csv\" \"pnpm ingest:iihs:csv\" \"pnpm ingest:fuel:csv\" \"pnpm ingest:infocar:csv\" \"pnpm ingest:infocar:videos:csv\" \"pnpm ingest:honda-videos:csv\" \"pnpm ingest:edrive:csv\" \"pnpm ingest:sketchfab:csv\" \"pnpm ingest:carshow360:csv\" \"pnpm ingest:topgear:csv\" \"pnpm ingest:press:csv\" \"pnpm ingest:wiki-images:csv\" \"pnpm ingest:youtube-videos:csv\" \"pnpm ingest:vehiclesdb:csv\" \"pnpm ingest:rdw:csv\" \"pnpm ingest:rdw-recalls:csv\" \"pnpm ingest:open-ev:csv\" \"pnpm ingest:mot:csv\" \"pnpm ingest:ca-recalls:csv\" \"pnpm ingest:generations:csv\" \"pnpm ingest:wikispecs:csv\" \"pnpm ingest:news:csv\" \"pnpm ingest:social:csv\" \"pnpm ingest:winner360:csv\" && pnpm ingest:recall-texts:csv",
    "ingest:euroncap": "pnpm --filter @carplates/scripts ingest:euroncap",
    "ingest:euroncap:csv": "pnpm --filter @carplates/scripts ingest:euroncap:csv",
    "export:euroncap:csv": "pnpm --filter @carplates/scripts export:euroncap:csv",
    "ingest:jncap": "pnpm --filter @carplates/scripts ingest:jncap",
    "ingest:jncap:csv": "pnpm --filter @carplates/scripts ingest:jncap:csv",
    "export:jncap:csv": "pnpm --filter @carplates/scripts export:jncap:csv",
    "ingest:cncap": "pnpm --filter @carplates/scripts ingest:cncap",
    "ingest:cncap:csv": "pnpm --filter @carplates/scripts ingest:cncap:csv",
    "export:cncap:csv": "pnpm --filter @carplates/scripts export:cncap:csv",
    "ingest:kncap": "pnpm --filter @carplates/scripts ingest:kncap",
    "ingest:kncap:csv": "pnpm --filter @carplates/scripts ingest:kncap:csv",
    "export:kncap:csv": "pnpm --filter @carplates/scripts export:kncap:csv",
    "ingest:iihs": "pnpm --filter @carplates/scripts ingest:iihs",
    "ingest:iihs:csv": "pnpm --filter @carplates/scripts ingest:iihs:csv",
    "export:model-families:csv": "pnpm --filter @carplates/scripts export:model-families:csv",
