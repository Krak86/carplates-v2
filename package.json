    "ingest:open-ev": "pnpm --filter @carplates/scripts ingest:open-ev",
    "ingest:open-ev:csv": "pnpm --filter @carplates/scripts ingest:open-ev:csv",
    "ingest:mot": "pnpm --filter @carplates/scripts ingest:mot",
    "ingest:mot:csv": "pnpm --filter @carplates/scripts ingest:mot:csv",
    "export:mot:csv": "pnpm --filter @carplates/scripts export:mot:csv",
    "export:open-ev:csv": "pnpm --filter @carplates/scripts export:open-ev:csv",
    "ingest:generations": "pnpm --filter @carplates/scripts ingest:generations",
