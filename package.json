    "ingest:youtube-videos:csv": "pnpm --filter @carplates/scripts ingest:youtube-videos:csv",
    "export:youtube-videos:csv": "pnpm --filter @carplates/scripts export:youtube-videos:csv",
    "ingest:wiki-images": "pnpm --filter @carplates/scripts ingest:wiki-images",
