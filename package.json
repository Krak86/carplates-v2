    "ingest:honda-videos:csv": "pnpm --filter @carplates/scripts ingest:honda-videos:csv",
    "export:honda-videos:csv": "pnpm --filter @carplates/scripts export:honda-videos:csv",
    "ingest:press": "pnpm --filter @carplates/scripts ingest:press",
    "ingest:press:csv": "pnpm --filter @carplates/scripts ingest:press:csv",
    "export:press:csv": "pnpm --filter @carplates/scripts export:press:csv",
    "ingest:topgear": "pnpm --filter @carplates/scripts ingest:topgear",
    "ingest:topgear:csv": "pnpm --filter @carplates/scripts ingest:topgear:csv",
    "export:topgear:csv": "pnpm --filter @carplates/scripts export:topgear:csv",
