    "ingest:ca-recalls:csv": "pnpm --filter @carplates/scripts ingest:ca-recalls:csv",
    "export:ca-recalls:csv": "pnpm --filter @carplates/scripts export:ca-recalls:csv",
    "ingest:rdw-recalls": "pnpm --filter @carplates/scripts ingest:rdw-recalls",
    "ingest:rdw-recalls:csv": "pnpm --filter @carplates/scripts ingest:rdw-recalls:csv",
    "ingest:rdw-recalls:translate": "pnpm --filter @carplates/scripts ingest:rdw-recalls:translate",
    "ingest:ca-recalls:translate": "pnpm --filter @carplates/scripts ingest:ca-recalls:translate",
    "export:rdw-recalls:csv": "pnpm --filter @carplates/scripts export:rdw-recalls:csv",
    "db:refresh-fuel-stats": "pnpm --filter @carplates/scripts refresh-fuel-stats",
    "ingest:vehiclesdb": "pnpm --filter @carplates/scripts ingest:vehiclesdb",
    "ingest:vehiclesdb:csv": "pnpm --filter @carplates/scripts ingest:vehiclesdb:csv",
    "export:vehiclesdb:csv": "pnpm --filter @carplates/scripts export:vehiclesdb:csv",
    "db:refresh-safety-stats": "pnpm --filter @carplates/scripts refresh-safety-stats",
    "db:refresh-vdb-stats": "pnpm --filter @carplates/scripts refresh-vdb-stats",
    "db:refresh-weight-stats": "pnpm --filter @carplates/scripts refresh-weight-stats",
    "db:refresh-spec-stats": "pnpm --filter @carplates/scripts refresh-spec-stats",
    "db:refresh-ev-stats": "pnpm --filter @carplates/scripts refresh-ev-stats",
    "db:refresh-imports-stats": "pnpm --filter @carplates/scripts refresh-imports-stats",
