# Copy to .env.local for local runs. Real env files are gitignored.

# Where the API lives. Empty = same origin (prod, or the Vite dev proxy).
VITE_API_BASE=

# Telemetry stays inert unless this is exactly "true" AND a key/DSN is set.
VITE_ENABLE_TELEMETRY=true
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SENTRY_DSN=
VITE_GIT_SHA=
VITE_DISQUS_SHORT_NAME=value

# Optional Google Maps Embed API key (free, unlimited; restrict it by HTTP referrer).
# Empty = keyless maps.google.com embed for the "Nearby services" map.
VITE_GOOGLE_MAPS_EMBED_KEY=

