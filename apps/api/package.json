{
  "name": "@carplates/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "preview": "node --env-file-if-exists=.env --env-file=preview.env dist/main.js",
    "type-check": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@carplates/db": "workspace:*",
    "@carplates/shared": "workspace:*",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.4",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nestjs": "^11.7.0",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.3.0",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
