# Copy to .env for local runs. Real .env is gitignored.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://carplates:carplates@localhost:5432/carplates

# Set to the built web app to serve it + inject per-plate meta tags from this API.
# Leave unset in day-to-day dev (Vite serves the frontend on :5173).
# WEB_DIST_DIR=../web/dist
PUBLIC_SITE_URL=http://localhost:3000

NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles

# Swagger UI at /api/docs (on by default outside production)
# ENABLE_SWAGGER=true

# Telemetry stays inert unless BOTH are set. Leave off locally.
# ENABLE_TELEMETRY=false
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# GIT_SHA=

PLATE_RECOGNIZER_CLOUD_URL=https://api.platerecognizer.com/v1/plate-reader/
PLATE_RECOGNIZER_CLOUD_TOKEN=
PLATE_RECOGNIZER_ONPREM_URL=
PLATE_RECOGNIZER_MONTHLY_BUDGET=2000
